+// Linux build patch: asked once per game, on its first launch from the game list, when it has no
+// shader warm-up yet. Returns true when it took over the launch.
+bool MainWindow::OfferShaderSetup(const QString& game_path, u64 program_id) {
+    if (program_id == 0 || QtCommon::emu_thread != nullptr || shader_warm_dialog ||
+        ShaderWarmFilesExist(program_id)) {
+        return false;
+    }
+    const auto marker = Common::FS::GetEdenPath(Common::FS::EdenPath::ConfigDir) /
+                        "shader-setup-offered" / fmt::format("{:016X}", program_id);
+    std::error_code ec;
+    if (std::filesystem::exists(marker, ec)) {
+        return false;
+    }
+    std::filesystem::create_directories(marker, ec);
+
+    QMessageBox box(this);
+    box.setIcon(QMessageBox::Question);
+    box.setWindowTitle(tr("Prepare Shaders"));
+    box.setText(tr("Prepare this game's shaders before playing?"));
+    box.setInformativeText(
+        tr("It's recommended to pre-build all of the game's shaders before playing: the game "
+           "runs much smoother. This can take 20 minutes or more depending on your system. The "
+           "game starts paused while they build, and you are told when it is ready to play.\n\n"
+           "You can also do it later: right-click the game and choose Prepare shaders, then use "
+           "Emulation > Prepare Shaders Now in the game."));
+    auto* prepare = box.addButton(tr("Prepare Shaders"), QMessageBox::AcceptRole);
+    box.addButton(tr("Play Now"), QMessageBox::RejectRole);
+    box.setDefaultButton(prepare);
+    box.exec();
+    if (box.clickedButton() != prepare) {
+        return false;
+    }
+
+    // Step 1: the warm-up files (a minute or two), then the game starts and step 2 builds them.
+    OnGameListPrepareShaderWarm(program_id, game_path.toStdString());
+    const QPointer<ShaderWarmDialog> dialog = shader_warm_dialog;
+    if (!dialog || !dialog->IsRunning()) {
+        return false;
+    }
+    connect(
+        dialog, &ShaderWarmDialog::BuildFinished, this,
+        [this, dialog, game_path, program_id](bool ok) {
+            if (!ok) {
+                return; // The window says why; the game is started from the list as usual.
+            }
+            if (dialog) {
+                dialog->close();
+            }
+            shader_setup_boot = true;
+            OnGameListLoadFile(game_path, program_id);
+            if (!emulation_running) {
+                shader_setup_boot = false;
+            }
+        },
+        Qt::QueuedConnection);
+    return true;
+}
+
+void MainWindow::StartShaderSetupRun() {
+    if (!emulation_running || !QtCommon::system->IsPoweredOn() ||
+        QtCommon::system->IsShuttingDown() ||
+        !QtCommon::system->GPU().ShaderNotify().WarmActive()) {
+        return;
+    }
+    // After the "Preparing shaders" screen (precompiled shaders), which holds the game itself.
+    if (QApplication::activeModalWidget() != nullptr) {
+        QTimer::singleShot(1000, this, &MainWindow::StartShaderSetupRun);
+        return;
+    }
+    if (QtCommon::emu_thread->IsRunning()) {
+        OnPauseGame();
+    }
+    shader_setup_run = true;
+    OnPrepareShadersNow();
+    if (!shader_warm_run_dialog) {
+        shader_setup_run = false;
+    }
+}
