+
+// Linux build patch (Tuxchii): AMD ships FSR 4 for Windows only. The AppImage carries fsr4-vk
+// (github.com/Astyyyyy/fsr4-vk, GPL-3.0), an open Vulkan implementation of FSR 4.1.1 built from
+// AMD's MIT-licensed FidelityFX SDK 2.3.0 files when Tuxchii is built. It exports the same FFX API
+// as AMD's upscaler, so it is called the same way. TUXCHII_FSR4_LIBRARY names another copy.
+namespace {
+std::mutex mutex;
+std::weak_ptr<const Api> current;
+
+struct Loaded : Api {
+    void* handle{};
+};
+
+std::filesystem::path LibraryPath() {
+    if (const char* path = std::getenv("TUXCHII_FSR4_LIBRARY"); path != nullptr && path[0]) {
+        return path;
+    }
+    std::error_code ec;
+    const std::filesystem::path exe = std::filesystem::read_symlink("/proc/self/exe", ec);
+    if (ec) {
+        return {};
+    }
+    // AppDir/usr/bin/<app> -> AppDir/usr/lib/fsr4/
+    return exe.parent_path().parent_path() / "lib" / "fsr4" / "amd_fidelityfx_upscaler_vk.so";
+}
+} // Anonymous namespace
+
+std::shared_ptr<const Api> Acquire() {
+    std::scoped_lock lock{mutex};
+    if (auto existing = current.lock()) {
+        return existing;
+    }
+    const std::filesystem::path path = LibraryPath();
+    std::error_code ec;
+    if (path.empty() || !std::filesystem::is_regular_file(path, ec)) {
+        LOG_INFO(Render_Vulkan, "AMD FSR 4: {} is missing; using FSR 3.1",
+                 Common::FS::PathToUTF8String(path));
+        return nullptr;
+    }
+    void* const handle = dlopen(path.c_str(), RTLD_NOW | RTLD_LOCAL);
+    if (handle == nullptr) {
+        const char* error = dlerror();
+        LOG_WARNING(Render_Vulkan, "AMD FSR 4: fsr4-vk doesn't load ({})",
+                    error ? error : "unknown error");
+        return nullptr;
+    }
+    auto loaded = std::make_unique<Loaded>();
+    loaded->handle = handle;
+    loaded->create_context = reinterpret_cast<PfnFfxCreateContext>(dlsym(handle, "ffxCreateContext"));
+    loaded->destroy_context =
+        reinterpret_cast<PfnFfxDestroyContext>(dlsym(handle, "ffxDestroyContext"));
+    loaded->query = reinterpret_cast<PfnFfxQuery>(dlsym(handle, "ffxQuery"));
+    loaded->dispatch = reinterpret_cast<PfnFfxDispatch>(dlsym(handle, "ffxDispatch"));
+    if (!loaded->create_context || !loaded->destroy_context || !loaded->query ||
+        !loaded->dispatch) {
+        LOG_WARNING(Render_Vulkan, "AMD FSR 4: fsr4-vk lacks the FFX API exports");
+        dlclose(handle);
+        return nullptr;
+    }
+    LOG_INFO(Render_Vulkan, "AMD FSR 4: fsr4-vk loaded from {}",
+             Common::FS::PathToUTF8String(path));
+    std::shared_ptr<const Loaded> shared{loaded.release(), [](const Loaded* l) {
+                                             dlclose(l->handle);
+                                             delete l;
+                                         }};
+    current = shared;
+    return shared;
+}
+
 #else
 
