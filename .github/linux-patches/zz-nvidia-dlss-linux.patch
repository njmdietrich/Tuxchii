diff --git a/src/yuzu/configuration/nvidia_dlss_panel_linux.cpp b/src/yuzu/configuration/nvidia_dlss_panel_linux.cpp
new file mode 100644
index 0000000..e7d12a8
--- /dev/null
+++ b/src/yuzu/configuration/nvidia_dlss_panel_linux.cpp
@@ -0,0 +1,426 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// Linux build patch: the "Install DLSS" button next to the NVIDIA DLSS setting.
+//
+// It downloads NVIDIA's DLSS SDK files (the NGX library and the DLSS model) straight from NVIDIA's
+// DLSS repository on GitHub, once the user has read and accepted NVIDIA's license, checks them
+// against known checksums, and links the MIT-licensed Fritchii DLSS bridge with them on this PC,
+// using the linker that ships in the AppImage. Nothing of NVIDIA's ships with Fritchii.
+
+#ifdef EGLANTINE_DLSS_BRIDGE
+
+#include "common/httplib.h"
+
+#include <array>
+#include <cstdio>
+#include <dlfcn.h>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <functional>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include <QApplication>
+#include <QCheckBox>
+#include <QCryptographicHash>
+#include <QDesktopServices>
+#include <QDialog>
+#include <QDialogButtonBox>
+#include <QHBoxLayout>
+#include <QLabel>
+#include <QMessageBox>
+#include <QPlainTextEdit>
+#include <QProcess>
+#include <QProgressDialog>
+#include <QPushButton>
+#include <QUrl>
+#include <QVBoxLayout>
+#include <fmt/format.h>
+
+#include "common/fs/path_util.h"
+#include "common/logging.h"
+#include "video_core/vulkan_common/fritchii_dlss_bridge.h"
+#include "video_core/vulkan_common/streamline.h"
+#include "yuzu/configuration/nvidia_dlss_panel.h"
+
+namespace {
+
+namespace Streamline = Vulkan::Streamline;
+
+// NVIDIA's DLSS SDK, pinned to the v310.9.16 release commit so the checksums below hold.
+constexpr const char* SDK_VERSION = "310.9.16";
+constexpr const char* SDK_HOST = "https://raw.githubusercontent.com";
+constexpr const char* SDK_PATH = "/NVIDIA/DLSS/9981c6350dc58c0ce21f024fd65e31e851c31689/";
+constexpr const char* SDK_PAGE = "https://github.com/NVIDIA/DLSS/tree/v310.9.16";
+
+struct SdkFile {
+    const char* path;      ///< In NVIDIA's repository
+    const char* name;      ///< Saved as
+    const char* sha256;
+    qint64 size;
+};
+
+constexpr SdkFile LICENSE{"LICENSE.txt", "NVIDIA-DLSS-SDK-LICENSE.txt",
+                          "d4216e39ebef5f9b50a6712ebb37beeb5379862a67733a9999c651f21592aaf0",
+                          26620};
+constexpr SdkFile NGX_LIBRARY{"lib/Linux_x86_64/libnvsdk_ngx.a", "libnvsdk_ngx.a",
+                              "d3c50bb0d9624fc35e502a8e929b8fc1e2b505017ebdb84c0d5b627e11a235df",
+                              89002};
+constexpr SdkFile DLSS_MODEL{"lib/Linux_x86_64/rel/libnvidia-ngx-dlss.so.310.9.16",
+                             "libnvidia-ngx-dlss.so.310.9.16",
+                             "30982c937afed85c96b8d313323de9a650a2eec6de1bb0f714b21750f4ce98f6",
+                             59481944};
+
+constexpr const char* BRIDGE = "libfritchii_dlss_bridge.so";
+
+QString Tr(const char* text) {
+    return QCoreApplication::translate("NvidiaDlssPanel", text);
+}
+
+QString PathText(const std::filesystem::path& path) {
+    return QString::fromStdString(Common::FS::PathToUTF8String(path));
+}
+
+/// The linker and the bridge object that ship in the AppImage (usr/bin/mold and
+/// usr/share/fritchii-dlss/fritchii_dlss_bridge.o), or FRITCHII_DLSS_TOOLS for development.
+struct Tools {
+    std::filesystem::path linker;
+    std::filesystem::path bridge_object;
+};
+
+std::optional<Tools> FindTools() {
+    std::vector<std::filesystem::path> dirs;
+    if (const char* const env = std::getenv("FRITCHII_DLSS_TOOLS")) {
+        dirs.emplace_back(env);
+    }
+    const std::filesystem::path bin =
+        std::filesystem::path{QCoreApplication::applicationDirPath().toStdString()};
+    dirs.push_back(bin / ".." / "share" / "fritchii-dlss");
+    std::error_code ec;
+    for (const std::filesystem::path& dir : dirs) {
+        const std::filesystem::path object = dir / "fritchii_dlss_bridge.o";
+        for (const std::filesystem::path& linker : {dir / "mold", bin / "mold"}) {
+            if (std::filesystem::is_regular_file(object, ec) &&
+                std::filesystem::is_regular_file(linker, ec)) {
+                return Tools{linker, object};
+            }
+        }
+    }
+    return std::nullopt;
+}
+
+/// The system's CA certificates, so HTTPS works whichever distribution the AppImage runs on.
+std::string CaBundle() {
+    std::error_code ec;
+    for (const char* path :
+         {"/etc/ssl/certs/ca-certificates.crt", "/etc/pki/tls/certs/ca-bundle.crt",
+          "/etc/ssl/ca-bundle.pem", "/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem",
+          "/etc/ssl/cert.pem"}) {
+        if (std::filesystem::is_regular_file(path, ec)) {
+            return path;
+        }
+    }
+    return {};
+}
+
+/// Downloads one SDK file into `target`, checking its size and SHA-256.
+bool Download(const SdkFile& file, const std::filesystem::path& target,
+              const std::function<bool(qint64)>& progress, std::string& error) {
+    httplib::Client client(SDK_HOST);
+    client.set_connection_timeout(30);
+    client.set_read_timeout(60);
+    client.set_follow_location(true);
+    if (const std::string ca = CaBundle(); !ca.empty()) {
+        client.set_ca_cert_path(ca);
+    }
+    std::ofstream out(target, std::ios::binary | std::ios::trunc);
+    if (!out) {
+        error = "could not write " + Common::FS::PathToUTF8String(target);
+        return false;
+    }
+    QCryptographicHash hash(QCryptographicHash::Sha256);
+    qint64 received = 0;
+    bool canceled = false;
+    const auto result = client.Get(
+        std::string{SDK_PATH} + file.path,
+        [&](const char* data, size_t length) {
+            out.write(data, static_cast<std::streamsize>(length));
+            hash.addData(QByteArrayView{data, static_cast<qsizetype>(length)});
+            received += static_cast<qint64>(length);
+            if (!progress(received)) {
+                canceled = true;
+                return false;
+            }
+            return static_cast<bool>(out);
+        });
+    out.close();
+    if (canceled) {
+        error = "canceled";
+        return false;
+    }
+    if (!result) {
+        error = httplib::to_string(result.error());
+        return false;
+    }
+    if (result->status != 200) {
+        error = fmt::format("HTTP {} for {}", result->status, file.path);
+        return false;
+    }
+    if (received != file.size || hash.result().toHex().toStdString() != file.sha256) {
+        error = fmt::format("{} from NVIDIA does not match the expected file", file.name);
+        return false;
+    }
+    return true;
+}
+
+/// Whether the bridge loads and is this build's version.
+bool CheckBridge(const std::filesystem::path& path, std::string& error) {
+    void* const module =
+        dlopen(Common::FS::PathToUTF8String(path).c_str(), RTLD_NOW | RTLD_LOCAL);
+    if (!module) {
+        const char* const message = dlerror();
+        error = std::string{"the linked bridge does not load: "} + (message ? message : "?");
+        return false;
+    }
+    const auto version = reinterpret_cast<uint32_t (*)()>(dlsym(module, "fdb_abi_version"));
+    const bool ok = version && version() == FDB_ABI_VERSION;
+    dlclose(module);
+    if (!ok) {
+        error = "the linked bridge is not this build's version";
+    }
+    return ok;
+}
+
+} // Anonymous namespace
+
+bool NvidiaDlssPanel::HasNvidiaDriver() {
+    std::error_code ec;
+    return std::filesystem::exists("/proc/driver/nvidia/version", ec);
+}
+
+bool NvidiaDlssPanel::IsInstalled() {
+    const Streamline::DlssFiles files = Streamline::FindDlssFiles();
+    return !files.interposer.empty() && !files.model.empty();
+}
+
+NvidiaDlssPanel::NvidiaDlssPanel(QWidget* parent, QCheckBox* checkbox_)
+    : QWidget(parent), checkbox{checkbox_} {
+    QHBoxLayout* layout = new QHBoxLayout(this);
+    layout->setContentsMargins(0, 0, 0, 0);
+    layout->setSpacing(8);
+    install_button = new QPushButton(this);
+    status_label = new QLabel(this);
+    status_label->setTextFormat(Qt::RichText);
+    status_label->setOpenExternalLinks(true);
+    layout->addWidget(install_button);
+    layout->addWidget(status_label);
+    connect(install_button, &QPushButton::clicked, this, [this] { Install(); });
+    Refresh();
+}
+
+void NvidiaDlssPanel::showEvent(QShowEvent* event) {
+    Refresh();
+    QWidget::showEvent(event);
+}
+
+void NvidiaDlssPanel::Refresh() {
+    const bool installed = IsInstalled();
+    if (installed) {
+        const Streamline::DlssFiles files = Streamline::FindDlssFiles();
+        status_label->setText(
+            QStringLiteral("<span style=\"color:#2ea043\">&#10004;</span> ") +
+            Tr("DLSS %1 installed").arg(QString::fromStdString(files.model_version)));
+        install_button->setText(Tr("Reinstall..."));
+    } else {
+        status_label->setText(Tr("Needs NVIDIA's DLSS files (about 60 MB)"));
+        install_button->setText(Tr("Install DLSS..."));
+    }
+    status_label->setToolTip(Tr("Folder: %1").arg(PathText(Streamline::UserFolder())));
+    // Can't be turned on before it's installed (unless it already was).
+    if (checkbox) {
+        checkbox->setEnabled(installed || checkbox->isChecked());
+    }
+}
+
+void NvidiaDlssPanel::Install() {
+    const auto fail = [this](const std::string& error) {
+        LOG_ERROR(Frontend, "NVIDIA DLSS install failed: {}", error);
+        QMessageBox::warning(this, Tr("NVIDIA DLSS"),
+                             Tr("NVIDIA DLSS could not be installed: %1")
+                                 .arg(QString::fromStdString(error)));
+        Refresh();
+    };
+    const std::optional<Tools> tools = FindTools();
+    if (!tools) {
+        fail("this build has no DLSS installer files (run the AppImage, not an extracted copy "
+             "without usr/share/fritchii-dlss)");
+        return;
+    }
+    const std::filesystem::path folder = Streamline::UserFolder();
+    const std::filesystem::path work = folder / ".install";
+    std::error_code ec;
+    std::filesystem::remove_all(work, ec);
+    std::filesystem::create_directories(work, ec);
+    if (ec) {
+        fail("could not create " + Common::FS::PathToUTF8String(work));
+        return;
+    }
+
+    // 1. NVIDIA's license, to read and accept first.
+    std::string error;
+    {
+        QProgressDialog busy(Tr("Getting NVIDIA's license..."), QString{}, 0, 0, this);
+        busy.setWindowTitle(Tr("NVIDIA DLSS"));
+        busy.setWindowModality(Qt::WindowModal);
+        busy.setMinimumDuration(0);
+        busy.show();
+        QApplication::processEvents();
+        if (!Download(LICENSE, work / LICENSE.name, [](qint64) { return true; }, error)) {
+            busy.close();
+            fail(error);
+            return;
+        }
+    }
+    QString license_text;
+    {
+        std::ifstream in(work / LICENSE.name, std::ios::binary);
+        license_text = QString::fromStdString(
+            std::string{std::istreambuf_iterator<char>{in}, std::istreambuf_iterator<char>{}});
+    }
+    QDialog dialog(this);
+    dialog.setWindowTitle(Tr("Install NVIDIA DLSS"));
+    QVBoxLayout* layout = new QVBoxLayout(&dialog);
+    QLabel* intro = new QLabel(
+        Tr("Fritchii will download NVIDIA's DLSS SDK %1 files (the NGX library and the DLSS "
+           "model, about 60 MB) from <a href=\"%2\">NVIDIA's DLSS repository</a> on GitHub, and "
+           "set them up for Fritchii on this PC in %3.<br><br>"
+           "These files are NVIDIA's, under NVIDIA's license below. They are not part of "
+           "Fritchii and are not shared by it. DLSS needs an NVIDIA RTX GPU and NVIDIA's "
+           "driver.")
+            .arg(QString::fromLatin1(SDK_VERSION), QString::fromLatin1(SDK_PAGE),
+                 PathText(folder)),
+        &dialog);
+    intro->setWordWrap(true);
+    intro->setOpenExternalLinks(true);
+    QPlainTextEdit* license = new QPlainTextEdit(license_text, &dialog);
+    license->setReadOnly(true);
+    license->setMinimumSize(640, 380);
+    QCheckBox* accept = new QCheckBox(Tr("I have read and accept NVIDIA's license"), &dialog);
+    QDialogButtonBox* buttons = new QDialogButtonBox(&dialog);
+    QPushButton* install = buttons->addButton(Tr("Install"), QDialogButtonBox::AcceptRole);
+    buttons->addButton(QDialogButtonBox::Cancel);
+    install->setEnabled(false);
+    connect(accept, &QCheckBox::toggled, install, &QPushButton::setEnabled);
+    connect(buttons, &QDialogButtonBox::accepted, &dialog, &QDialog::accept);
+    connect(buttons, &QDialogButtonBox::rejected, &dialog, &QDialog::reject);
+    layout->addWidget(intro);
+    layout->addWidget(license, 1);
+    layout->addWidget(accept);
+    layout->addWidget(buttons);
+    if (dialog.exec() != QDialog::Accepted || !accept->isChecked()) {
+        std::filesystem::remove_all(work, ec);
+        return;
+    }
+
+    // 2. NVIDIA's files.
+    const qint64 total = NGX_LIBRARY.size + DLSS_MODEL.size;
+    QProgressDialog progress(Tr("Downloading NVIDIA DLSS..."), Tr("Cancel"), 0, 1000, this);
+    progress.setWindowTitle(Tr("NVIDIA DLSS"));
+    progress.setWindowModality(Qt::WindowModal);
+    progress.setMinimumDuration(0);
+    progress.setValue(0);
+    QApplication::processEvents();
+    qint64 done = 0;
+    for (const SdkFile* file : {&NGX_LIBRARY, &DLSS_MODEL}) {
+        const bool ok = Download(
+            *file, work / file->name,
+            [&](qint64 received) {
+                progress.setValue(static_cast<int>((done + received) * 1000 / total));
+                QApplication::processEvents();
+                return !progress.wasCanceled();
+            },
+            error);
+        if (!ok) {
+            progress.close();
+            std::filesystem::remove_all(work, ec);
+            if (error != "canceled") {
+                fail(error);
+            }
+            return;
+        }
+        done += file->size;
+    }
+    progress.setLabelText(Tr("Setting up NVIDIA DLSS..."));
+    progress.setCancelButton(nullptr);
+    progress.setRange(0, 0);
+    QApplication::processEvents();
+
+    // 3. Link the bridge here, with NVIDIA's library.
+    QProcess linker;
+    linker.setProcessChannelMode(QProcess::MergedChannels);
+    const QStringList arguments{
+        QStringLiteral("-shared"),
+        QStringLiteral("-o"),
+        PathText(work / BRIDGE),
+        QStringLiteral("-soname"),
+        QString::fromLatin1(BRIDGE),
+        QStringLiteral("--gc-sections"),
+        QStringLiteral("--exclude-libs"),
+        QStringLiteral("ALL"),
+        QStringLiteral("-z"),
+        QStringLiteral("now"),
+        PathText(tools->bridge_object),
+        PathText(work / NGX_LIBRARY.name),
+    };
+    linker.start(PathText(tools->linker), arguments);
+    if (!linker.waitForFinished(120000) || linker.exitStatus() != QProcess::NormalExit ||
+        linker.exitCode() != 0) {
+        const std::string output = linker.readAll().toStdString();
+        progress.close();
+        std::filesystem::remove_all(work, ec);
+        fail("linking the DLSS bridge failed: " +
+             (output.empty() ? linker.errorString().toStdString() : output));
+        return;
+    }
+    if (!CheckBridge(work / BRIDGE, error)) {
+        progress.close();
+        std::filesystem::remove_all(work, ec);
+        fail(error);
+        return;
+    }
+
+    // 4. Into place. Older DLSS models go, so the newest is the one used.
+    for (const auto& entry : std::filesystem::directory_iterator(folder, ec)) {
+        const std::string name = entry.path().filename().string();
+        if (name.starts_with("libnvidia-ngx-dlss.so.") && name != DLSS_MODEL.name) {
+            std::filesystem::remove(entry.path(), ec);
+        }
+    }
+    bool moved = true;
+    for (const char* name : {DLSS_MODEL.name, LICENSE.name, BRIDGE}) {
+        std::filesystem::rename(work / name, folder / name, ec);
+        moved = moved && !ec;
+    }
+    std::filesystem::remove_all(work, ec);
+    progress.close();
+    if (!moved) {
+        fail("could not save the files in " + Common::FS::PathToUTF8String(folder));
+        return;
+    }
+    LOG_INFO(Frontend, "NVIDIA DLSS {} installed in {}", SDK_VERSION,
+             Common::FS::PathToUTF8String(folder));
+    if (checkbox) {
+        checkbox->setEnabled(true);
+        checkbox->setChecked(true);
+    }
+    Refresh();
+    QMessageBox::information(
+        this, Tr("NVIDIA DLSS"),
+        Tr("NVIDIA DLSS is installed and turned on. Press OK or Apply to save the setting; it is "
+           "used the next time a game starts."));
+}
