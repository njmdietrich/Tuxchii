diff --git a/src/video_core/CMakeLists.txt b/src/video_core/CMakeLists.txt
index bf83c1b..bcc8a75 100644
--- a/src/video_core/CMakeLists.txt
+++ b/src/video_core/CMakeLists.txt
@@ -638,4 +638,23 @@ if (ENABLE_NVIDIA_DLSS)
     message(STATUS "NVIDIA DLSS through Streamline: ${STREAMLINE_INCLUDE_DIR}")
 endif()
 
+# Linux build patch: NVIDIA DLSS on Linux through the Fritchii DLSS bridge (NVIDIA NGX). Nothing of
+# NVIDIA's is compiled in or linked: the bridge is loaded at run time from the user folder, where
+# Settings > Graphics > Install DLSS links it from NVIDIA's SDK files on the user's own PC.
+option(ENABLE_NVIDIA_DLSS_LINUX "Enable NVIDIA DLSS on Linux through the Fritchii DLSS bridge" ON)
+if (ENABLE_NVIDIA_DLSS_LINUX AND CMAKE_SYSTEM_NAME STREQUAL "Linux" AND ARCHITECTURE_x86_64
+    AND NOT ENABLE_NVIDIA_DLSS)
+    target_sources(video_core PRIVATE
+        renderer_vulkan/vk_streamline_dlss_linux.cpp
+        renderer_vulkan/vk_streamline_dlss.h
+        vulkan_common/fritchii_dlss_bridge.h
+        vulkan_common/streamline_linux.cpp
+        vulkan_common/streamline_linux.h
+        vulkan_common/streamline.h
+    )
+    target_link_libraries(video_core PRIVATE ${CMAKE_DL_LIBS})
+    target_compile_definitions(video_core PUBLIC EGLANTINE_STREAMLINE EGLANTINE_DLSS_BRIDGE)
+    message(STATUS "NVIDIA DLSS through the Fritchii DLSS bridge (Linux)")
+endif()
+
 create_target_directory_groups(video_core)
