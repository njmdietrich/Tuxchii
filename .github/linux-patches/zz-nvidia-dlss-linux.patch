+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// Linux build patch: the Fritchii DLSS bridge's functions (see streamline_linux.cpp).
+
+#pragma once
+
+#include <string>
+
+#include "video_core/vulkan_common/fritchii_dlss_bridge.h"
+
+namespace Vulkan::Streamline {
+
+struct Bridge {
+    decltype(&fdb_abi_version) abi_version{};
+    decltype(&fdb_required_extensions) required_extensions{};
+    decltype(&fdb_init) init{};
+    decltype(&fdb_render_size_range) render_size_range{};
+    decltype(&fdb_evaluate) evaluate{};
+    decltype(&fdb_shutdown) shutdown{};
+    decltype(&fdb_last_error) last_error{};
+};
+
+/// Loads the installed bridge (once). Returns null and says why when it can't.
+const Bridge* LoadBridge(std::string* error = nullptr);
+
+/// The loaded bridge; only valid after Start() succeeded.
+const Bridge& GetBridge();
+
+} // namespace Vulkan::Streamline
