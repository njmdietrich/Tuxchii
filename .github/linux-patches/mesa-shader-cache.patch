diff --git a/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp b/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp
index cccddd3577..cef25f771b 100644
--- a/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp
+++ b/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp
@@ -671,6 +671,20 @@ bool DriverCachesPipelines(const Device& device) {
     case VK_DRIVER_ID_NVIDIA_PROPRIETARY:
     case VK_DRIVER_ID_AMD_PROPRIETARY:
         return true;
+#if defined(__linux__) && !defined(__ANDROID__)
+    // Linux build patch: Mesa's drivers (RADV on the Steam Deck and AMD, ANV on Intel, NVK) keep
+    // their own shader cache on disk, like NVIDIA's and AMD's Windows drivers. Prepared pipelines
+    // go there; otherwise they piled up in the emulator's pipeline cache, which is held in memory
+    // and filled 32 GB of RAM and swap before OoT's ~120,000 pipelines were done (issue #6).
+    // Unless the player turned Mesa's cache off (MESA_SHADER_CACHE_DISABLE).
+    case VK_DRIVER_ID_MESA_RADV:
+    case VK_DRIVER_ID_INTEL_OPEN_SOURCE_MESA:
+    case VK_DRIVER_ID_MESA_NVK: {
+        const char* disable = std::getenv("MESA_SHADER_CACHE_DISABLE");
+        return disable == nullptr || std::string_view{disable} == "false" ||
+               std::string_view{disable} == "0";
+    }
+#endif
     default:
         return false;
     }
