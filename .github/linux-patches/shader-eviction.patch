+std::unique_ptr<GraphicsPipeline> PipelineCache::RebuildGraphicsPipeline(KeptGraphicsStages kept) {
+    std::array<const Shader::Info*, Maxwell::MaxShaderStage> infos{};
+    for (size_t stage = 0; stage < infos.size(); ++stage) {
+        infos[stage] = kept.infos[stage].get();
+    }
+    GraphicsPipeline::EmitStagesFunc emit = [spirv = std::move(kept.spirv)](auto&) {
+        std::array<std::vector<u32>, Maxwell::MaxShaderStage> code;
+        for (size_t stage = 0; stage < code.size(); ++stage) {
+            if (spirv[stage].empty()) {
+                continue;
+            }
+            const auto data = Common::Compression::DecompressDataZSTD(spirv[stage]);
+            if (data.empty() || data.size() % sizeof(u32) != 0) {
+                throw Shader::RuntimeError("Invalid retained graphics SPIR-V");
+            }
+            code[stage].resize(data.size() / sizeof(u32));
+            std::memcpy(code[stage].data(), data.data(), data.size());
+        }
+        return code;
+    };
+    auto pipeline = std::make_unique<GraphicsPipeline>(
+        scheduler, buffer_cache, texture_cache, PlayPipelineCache(), &shader_notify, device,
+        descriptor_pool, guest_descriptor_queue, descriptor_buffer_ring, &workers, nullptr,
+        render_pass_cache, graphics_key, std::array<std::vector<u32>, Maxwell::MaxShaderStage>{},
+        infos, std::move(emit), kept.libraries, std::move(kept.mesh_emulation));
+    pipeline->SetMappedPointers(std::move(kept.mapped_pointers));
+    return pipeline;
