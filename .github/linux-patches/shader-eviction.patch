+u64 KeptGraphicsStages::Bytes() const noexcept {
+    u64 bytes = sizeof(*this);
+    for (size_t stage = 0; stage < NUM_STAGES; ++stage) {
+        bytes += spirv[stage].size() + (infos[stage] ? sizeof(Shader::Info) : 0);
