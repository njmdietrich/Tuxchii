+struct Release {
+    QString tag;
+    QString version;     ///< "v5.9"
+    unsigned build{};    ///< workflow run number; 0 when the release doesn't say
+    QString page;        ///< the release's web page
+    QString appimage;    ///< asset name, "Tuxchii-v5.9-x86_64.AppImage"
+    QString appimage_url;
+    QString sha256_url;
+    qint64 size{};
+};
+
+struct CheckResult {
+    std::optional<Release> update;
+    QString error;
+};
