+static Uint16 ReadHDValue(const Uint8 *data)
+{
+    return (Uint16)(data[0] | ((Uint16)data[1] << 8));
+}
+
 static bool HIDAPI_DriverSwitch2_SendJoystickEffect(SDL_HIDAPI_Device *device, SDL_Joystick *joystick, const void *data, int size)
 {
-    return SDL_Unsupported();
+    static const Uint8 magic[8] = { 'L', 'C', 'H', '2', 'H', 'D', '0', '1' };
+    SDL_DriverSwitch2_Context *ctx = (SDL_DriverSwitch2_Context *)device->context;
+    const Uint8 *effect = (const Uint8 *)data;
+    Uint64 now;
+    int side;
+
+    if (device->is_bluetooth || device->product_id != USB_PRODUCT_NINTENDO_SWITCH2_PRO ||
+        !effect || (size != 8 && size != 28) || SDL_memcmp(effect, magic, 8) != 0) {
+        return SDL_Unsupported();
+    }
+    if (size == 8) {
+        return true; /* Capability query: no controller state or output changes. */
+    }
+
+    now = SDL_GetTicks();
+    for (side = 0; side < 2; ++side) {
+        const Uint8 *sample = effect + 8 + side * 10;
+        Uint16 high_amp = SDL_min(ReadHDValue(sample + 2), RUMBLE_MAX >> 6);
+        Uint16 low_amp = SDL_min(ReadHDValue(sample + 6), RUMBLE_MAX >> 6);
+        const Uint16 duration = SDL_min(ReadHDValue(sample + 8), 2000);
+        const unsigned int sum = high_amp + low_amp;
+        if (sum > (RUMBLE_MAX >> 6)) {
+            high_amp = (Uint16)(high_amp * (RUMBLE_MAX >> 6) / sum);
+            low_amp = (Uint16)(low_amp * (RUMBLE_MAX >> 6) / sum);
+        }
+        ctx->hd_rumble[side].high_freq = SDL_clamp(ReadHDValue(sample), 1, 1023);
+        ctx->hd_rumble[side].high_amp = duration ? high_amp : 0;
+        ctx->hd_rumble[side].low_freq = SDL_clamp(ReadHDValue(sample + 4), 1, 1023);
+        ctx->hd_rumble[side].low_amp = duration ? low_amp : 0;
+        ctx->hd_rumble[side].expires = now + duration;
+    }
+    if (!ctx->hd_rumble_enabled) {
+        ctx->rumble_timestamp = 0;
+    }
+    ctx->hd_rumble_enabled = true;
+    ctx->rumble_updated = true;
+    return UpdateRumble(ctx);
 }
 
